<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>WuHealthGuard.Tray</RootNamespace>
    <AssemblyName>WuHealthGuard</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Dynamic COM (WUA) and WinForms aren't trim-safe. -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- WinForms event handlers and UI strings: these rules are noise here. -->
    <NoWarn>$(NoWarn);CA1303;CA2000;CA1031</NoWarn>
  </PropertyGroup>

  <!--
    Auto-update. Both are empty in developer/CI builds, which turns updates off.
    The release workflow sets them: the public half of the UPDATE_SIGNING_KEY secret, and the feed URL.
  -->
  <ItemGroup>
    <AssemblyMetadata Include="UpdatePublicKey" Value="$(UpdatePublicKey)" />
    <AssemblyMetadata Include="UpdateFeedUrl" Value="$(UpdateFeedUrl)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WuHealthGuard.Windows\WuHealthGuard.Windows.csproj" />
  </ItemGroup>

</Project>
